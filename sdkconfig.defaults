# ============================================================
# sdkconfig.defaults — применяется при первой генерации sdkconfig
# (platformio.ini уже ссылается на этот файл, но физически он отсутствовал)
# ============================================================

# --- PSRAM: Octal, нужен для N8R16 ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- WiFi: нужен promiscuous mode + больше буферов под сканирование ---
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# --- FAT FS на SD: длинные имена файлов на всякий случай ---
CONFIG_FATFS_LFN_HEAP=y

# --- SD/MMC карта через SPI ---
CONFIG_SDMMC_GENERIC_IO_TIMEOUT_MS=5000
CONFIG_SDMMC_DATA_TIMEOUT_MS=5000

# --- SPI: настройки для общей шины (E-ink + SD) ---
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# --- Логи: дебаг на старте проекта ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Основной стек ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- C++ exceptions: использует ArduinoJson внутри ---
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# --- Certificate bundle: отключаем (проблема с генерацией в PlatformIO) ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
