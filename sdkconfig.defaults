# ============================================================
# sdkconfig.defaults — применяется при первой генерации sdkconfig
# (platformio.ini уже ссылается на этот файл, но физически он отсутствовал)
# ============================================================

# --- PSRAM: Octal, нужен для N8R16 ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- WiFi: нужен promiscuous mode + больше буферов под сканирование ---
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# --- FAT FS на SD: длинные имена файлов на всякий случай ---
CONFIG_FATFS_LFN_HEAP=y

# --- SD/MMC карта через SPI ---
CONFIG_SDMMC_GENERIC_IO_TIMEOUT_MS=5000
CONFIG_SDMMC_DATA_TIMEOUT_MS=5000

# --- SPI: настройки для общей шины (E-ink + SD) ---
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# --- Логи: дебаг на старте проекта ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Основной стек ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- C++ exceptions: использует ArduinoJson внутри ---
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# --- Certificate bundle: отключаем (проблема с генерацией в PlatformIO) ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# --- Arduino (как IDF компонент для GxEPD2) ---
# Требуется FreeRTOS 1000Hz (arduino-esp32 использует vTaskDelay для delay())
CONFIG_FREERTOS_HZ=1000
# Выборочная компиляция: только SPI и Wire (Wire пока не нужен, но оставим по умолчанию)
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_SPI=y
# Отключаем всё остальное
CONFIG_ARDUINO_SELECTIVE_Wire=n
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n
CONFIG_ARDUINO_SELECTIVE_EEPROM=n
CONFIG_ARDUINO_SELECTIVE_Preferences=n
CONFIG_ARDUINO_SELECTIVE_Ticker=n
CONFIG_ARDUINO_SELECTIVE_Update=n
CONFIG_ARDUINO_SELECTIVE_Zigbee=n
CONFIG_ARDUINO_SELECTIVE_FS=n
CONFIG_ARDUINO_SELECTIVE_SD=n
CONFIG_ARDUINO_SELECTIVE_SD_MMC=n
CONFIG_ARDUINO_SELECTIVE_SPIFFS=n
CONFIG_ARDUINO_SELECTIVE_FFat=n
CONFIG_ARDUINO_SELECTIVE_LittleFS=n
CONFIG_ARDUINO_SELECTIVE_Network=n
CONFIG_ARDUINO_SELECTIVE_Ethernet=n
CONFIG_ARDUINO_SELECTIVE_PPP=n
CONFIG_ARDUINO_SELECTIVE_Hash=n
CONFIG_ARDUINO_SELECTIVE_ArduinoOTA=n
CONFIG_ARDUINO_SELECTIVE_AsyncUDP=n
CONFIG_ARDUINO_SELECTIVE_DNSServer=n
CONFIG_ARDUINO_SELECTIVE_ESPmDNS=n
CONFIG_ARDUINO_SELECTIVE_HTTPClient=n
CONFIG_ARDUINO_SELECTIVE_Matter=n
CONFIG_ARDUINO_SELECTIVE_NetBIOS=n
CONFIG_ARDUINO_SELECTIVE_WebServer=n
CONFIG_ARDUINO_SELECTIVE_WiFi=n
CONFIG_ARDUINO_SELECTIVE_NetworkClientSecure=n
CONFIG_ARDUINO_SELECTIVE_WiFiProv=n
CONFIG_ARDUINO_SELECTIVE_BLE=n
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
CONFIG_ARDUINO_SELECTIVE_SimpleBLE=n
CONFIG_ARDUINO_SELECTIVE_RainMaker=n
CONFIG_ARDUINO_SELECTIVE_OpenThread=n
CONFIG_ARDUINO_SELECTIVE_Insights=n
# Отключаем автозапуск (у нас свой app_main)
CONFIG_AUTOSTART_ARDUINO=n
